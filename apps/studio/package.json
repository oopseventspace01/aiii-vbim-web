{
  "name": "@aiii/studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "seed": "sanity exec ../../scripts/seed.ts --with-user-token",
    "seed:force": "sanity exec ../../scripts/seed.ts --with-user-token -- --force",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts && node tests/e2e/validate-sample-content.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@sanity/document-internationalization": "^6.2.43",
    "@sanity/vision": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.19.0",
    "sanity-plugin-internationalized-array": "^5.3.6",
    "styled-components": "^6.6.0"
  }
}
