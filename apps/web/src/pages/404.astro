---
// 404：中英文並列（同一個 404 頁會服務 / 與 /en 底下所有找不到的網址）
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="404 · Aiii VBIM"
  locale="zh-Hant"
  noindex
  alternates={{ 'zh-Hant': '/', en: '/en' }}
>
  <section class="container-site flex min-h-[60vh] flex-col justify-center gap-6 py-20">
    <p class="eyebrow m-0">404 · PAGE NOT FOUND</p>
    <h1 class="m-0 text-[clamp(2rem,4vw,3rem)] leading-tight font-black">
      找不到這個頁面
      <span lang="en" class="block font-display text-[0.6em] font-bold text-text-2">
        We can’t find that page.
      </span>
    </h1>
    <p class="lead m-0 max-w-[640px]">
      網址可能已經變更或輸入錯誤。<span lang="en">The link may have changed or been mistyped.</span>
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href="/">回到首頁</Button>
      <Button href="/en" variant="outline">
        <span lang="en">Back to home</span>
      </Button>
      <Button href="/contact" variant="outline">
        聯絡我們
      </Button>
    </div>
  </section>
</BaseLayout>
