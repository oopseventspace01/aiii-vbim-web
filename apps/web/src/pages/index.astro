  <main class="mx-auto flex min-h-screen max-w-(--max) flex-col justify-center px-4">
    <p class="font-display text-sm tracking-widest text-blue">AIII VBIM OS 2.0</p>
    <h1 class="mt-4 font-display text-4xl font-bold md:text-6xl">
      One OS. Every Building. Every System.
    </h1>
    <p class="mt-4 text-text-2">建置中（P0 空白首頁）</p>
  </main>
</BaseLayout>
