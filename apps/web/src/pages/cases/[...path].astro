---
// 後台「公開顯示」案例的內頁（/cases/{網址代稱}）。
// 2026-11-16 案例列表併入五大領域：/cases 301 → /solutions#cases（見 redirects.mjs）
import CaseDetailPage from '../../components/pages/CaseDetailPage.astro';
import { getPublicCases, pickCases, type CaseEntry } from '../../lib/cms-pages';

export async function getStaticPaths() {
  const cases = pickCases(await getPublicCases(), 'zh-Hant');
  return cases.map((entry) => ({ params: { path: entry.slug! }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CaseEntry };
---

<CaseDetailPage locale="zh-Hant" entry={entry} />
