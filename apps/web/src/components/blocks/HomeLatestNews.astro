---
// 首頁 Hero 正下方的「最新消息」大卡片：照片是重點（業主要求越大越好）
// 桌機照片佔卡片 2/3 寬、文字在右；手機照片在最上面滿寬；照片不裁切（依原比例）
// 內容來自後台（挑選規則見 content/home-latest-news.ts）
import MediaFigure from './MediaFigure.astro';
import Icon from '../ui/Icon.astro';
import { imageUrl } from '../../lib/sanity';
import { localizePath, type Locale } from '../../lib/i18n';
import { UI } from '../../i18n/ui';
import { HOME_LATEST_NEWS_COPY, type LatestNews } from '../../content/home-latest-news';

interface Props {
  news: LatestNews;
  locale: Locale;
}

const { news, locale } = Astro.props;
const { card, fallback } = news;
const copy = HOME_LATEST_NEWS_COPY[locale];
const meta = [card.source, card.dateLabel].filter(Boolean).join(' · ');
---

<section
  aria-labelledby="home-latest-news"
  class="border-b border-line bg-bg-2"
  data-home-latest-news
>
  <div class="container-site flex flex-col gap-6 py-14">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="home-latest-news" class="m-0 text-[1.8rem] font-black">
        {copy.title}
      </h2>
      <a href={localizePath('/news', locale)} class="font-bold no-underline" data-latest-all>
        {copy.viewAll}
      </a>
    </div>
    <article
      class="relative grid overflow-hidden rounded-lg border border-line bg-white md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] md:items-center"
      data-latest-card
    >
      {card.cover && (
        <div class="relative z-10 min-w-0" data-latest-photo>
          <MediaFigure
            src={imageUrl(card.cover.source, 1600)}
            sizes="(min-width: 1280px) 820px, (min-width: 768px) 66vw, 100vw"
            eager
            zoom
            zoomSrc={imageUrl(card.cover.source, 2400)}
            alt={card.cover.alt}
            width={card.cover.width}
            height={card.cover.height}
          />
        </div>
      )}
      <div class="flex min-w-0 flex-col gap-3 p-5 md:p-8">
        {meta && (
          <span class="text-sm font-bold text-blue" data-latest-meta>
            {meta}
          </span>
        )}
        <h3 class="m-0 text-[clamp(1.4rem,2.2vw,1.9rem)] leading-[1.3] font-black">
          <a
            href={card.href}
            target={card.external ? '_blank' : undefined}
            rel={card.external ? 'noopener noreferrer' : undefined}
            class="text-navy no-underline after:absolute after:inset-0 hover:text-blue"
            data-latest-link
          >
            {card.title}
            {card.external && (
              <>
                <Icon name="external" size={20} class="ml-1 inline align-[-2px] text-muted" />
                <span class="sr-only">{copy.newTab}</span>
              </>
            )}
          </a>
        </h3>
        {card.excerpt && <p class="m-0 text-text-2">{card.excerpt}</p>}
        {fallback && <p class="m-0 text-sm text-muted">{UI[locale].comingSoon}</p>}
      </div>
    </article>
  </div>
</section>
