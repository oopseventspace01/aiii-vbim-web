---
// 60 秒影片區（SPEC 3.1 第 2 項）
// 沒有影片網址：顯示封面＋「影片製作中」；有網址：<video muted playsinline controls>，不自動播放聲音
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  poster: ImageMetadata;
  alt: string;
  inProductionLabel: string;
  videoUrl?: string;
  captionsUrl?: string;
  captionsLang?: string;
  timeline?: { time: string; label: string }[];
  timelineLabel?: string;
}

const {
  poster,
  alt,
  inProductionLabel,
  videoUrl,
  captionsUrl,
  captionsLang = 'zh-Hant',
  timeline = [],
  timelineLabel,
} = Astro.props;
---

<div class="flex flex-col gap-3">
  <div class="relative overflow-hidden rounded-lg">
    {videoUrl ? (
      <video
        class="block aspect-video w-full bg-navy object-cover"
        src={videoUrl}
        poster={typeof poster === 'string' ? poster : poster.src}
        muted
        playsinline
        controls
        preload="none"
      >
        {captionsUrl && <track kind="captions" src={captionsUrl} srclang={captionsLang} default />}
      </video>
    ) : (
      <>
        <Image
          src={poster}
          alt={alt}
          widths={[480, 760, 1040]}
          sizes="(min-width: 1024px) 620px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="block aspect-video w-full object-cover"
        />
        <span class="absolute right-4 bottom-4 rounded-pill bg-navy/85 px-3.5 py-1.5 text-sm font-bold text-white">
          {inProductionLabel}
        </span>
      </>
    )}
  </div>
  {timeline.length > 0 && (
    <ol
      aria-label={timelineLabel}
      class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(110px,1fr))] gap-2 p-0"
    >
      {timeline.map((step) => (
        <li class="rounded-xl border border-line bg-white px-3 py-2">
          <span class="block font-display text-xs font-semibold text-blue">{step.time}</span>
          <span class="text-sm font-bold">{step.label}</span>
        </li>
      ))}
    </ol>
  )}
</div>
