---
// 表單預留區：P5 會換成正式的預約／申請／登記表單（data-form-pending 供 P5 檢查是否已全部替換）
// 在那之前，提供真實的 Email 與 LINE 官方帳號讓訪客聯繫
import Button from '../ui/Button.astro';
import type { FooterInfo } from '../../data/site-fallback';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  info: FooterInfo;
  /** 頁面另外有 LINE 區塊時設為 false，避免重複 */
  showLine?: boolean;
}

const { locale, info, showLine = true } = Astro.props;
const zh = locale === 'zh-Hant';
---

<div
  class="flex flex-col gap-4 rounded-md border border-dashed border-line-2 bg-white p-6"
  data-form-pending
>
  <p class="m-0 font-bold">
    {zh
      ? `線上表單即將開放。現在可以直接${showLine ? '來信或加入 LINE 官方帳號' : '來信'}與我們聯繫：`
      : `The online form is coming soon. In the meantime, reach us by email${showLine ? ' or on LINE' : ''}:`}
  </p>
  <div class="flex flex-wrap gap-3">
    {info.email && <Button href={`mailto:${info.email}`}>{info.email}</Button>}
    {showLine && info.lineOfficialUrl && (
      <Button
        href={info.lineOfficialUrl}
        variant="outline"
        external
        newTabLabel={zh ? '（另開新視窗）' : '(opens in a new tab)'}
      >
        {zh ? 'LINE 官方帳號' : 'LINE Official Account'}
      </Button>
    )}
  </div>
</div>
