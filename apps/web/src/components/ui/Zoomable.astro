---
// 可以點擊放大的圖片外框：把圖片包在 <button> 裡，點了用原生 <dialog> 顯示大圖
// 用法：<Zoomable src={原圖或大尺寸網址} mockupLabel?>…<Image …/></Zoomable>
// 放大的圖沿用裡面那張圖的 alt；「示意畫面」標示放大後也會顯示
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ZOOM_COPY, localeFromPath, zoomWidth } from '../../content/zoom';

interface Props {
  /** 放大時用的圖：本機圖片會輸出較大的尺寸；字串（後台圖片網址）直接使用 */
  src: ImageMetadata | string;
  mockupLabel?: string;
  class?: string;
}

const { src, mockupLabel, class: className } = Astro.props;
const copy = ZOOM_COPY[localeFromPath(Astro.url.pathname)];
const zoomSrc =
  typeof src === 'string'
    ? src
    : (await getImage({ src, width: zoomWidth(src.width), format: 'webp' })).src;
---

<button
  type="button"
  class:list={['zoom-trigger', className]}
  aria-label={copy.open}
  aria-haspopup="dialog"
  data-zoomable
  data-zoom-src={zoomSrc}
  data-zoom-mockup={mockupLabel}
  data-zoom-close={copy.close}
  data-zoom-dialog={copy.dialog}
>
  <slot />
  <i class="zoom-hint" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
    >
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="M16 16l4.5 4.5M11 8v6M8 11h6"></path>
    </svg>
  </i>
</button>

<style is:global>
  .zoom-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    text-align: inherit;
    color: inherit;
    border-radius: 0.5rem;
  }
  .zoom-trigger:focus-visible {
    outline: 3px solid var(--color-blue, #1565c0);
    outline-offset: 3px;
  }
  /* 角落的放大鏡提示（用 <i> 不用 <span>，避免和「示意畫面」標示混在一起） */
  .zoom-hint {
    font-style: normal;
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: rgb(10 27 61 / 0.78);
    color: #fff;
    pointer-events: none;
  }
  .zoom-dialog {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 3.5rem 1rem 1rem;
    border: 0;
    background: transparent;
    overflow: auto;
  }
  .zoom-dialog::backdrop {
    background: rgb(5 12 28 / 0.88);
  }
  .zoom-dialog figure {
    position: relative;
    display: flex;
    min-height: 100%;
    margin: 0;
    align-items: center;
    justify-content: center;
  }
  .zoom-dialog img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 4.5rem);
    width: auto;
    height: auto;
    border-radius: 0.5rem;
    background: #fff;
    cursor: zoom-out;
  }
  .zoom-dialog .zoom-mockup {
    position: absolute;
    left: 50%;
    bottom: 0.75rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: rgb(10 27 61 / 0.92);
    padding: 0.375rem 0.875rem;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .zoom-dialog .zoom-close {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #0a1b3d;
    font-size: 1.25rem;
    font-weight: 700;
    cursor: pointer;
  }
  .zoom-dialog .zoom-close:focus-visible {
    outline: 3px solid #7fb2ff;
    outline-offset: 2px;
  }
  html:has(.zoom-dialog[open]) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .zoom-dialog[open] img {
      animation: zoom-pop 180ms ease-out;
    }
    .zoom-dialog[open]::backdrop {
      animation: zoom-fade 180ms ease-out;
    }
  }
  @keyframes zoom-pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  @keyframes zoom-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  let dialog: HTMLDialogElement | null = null;
  let trigger: HTMLElement | null = null;

  function ensureDialog(): HTMLDialogElement {
    if (dialog) return dialog;
    const d = document.createElement('dialog');
    d.className = 'zoom-dialog';
    d.setAttribute('data-zoom-lightbox', '');
    d.innerHTML =
      '<button type="button" class="zoom-close" data-zoom-close-btn>✕</button>' +
      '<figure><img alt="" data-zoom-img /><span class="zoom-mockup" data-zoom-mockup-label hidden></span></figure>';
    // 點背景（圖片以外的地方）或 ✕ 關閉；Esc 由瀏覽器原生處理
    d.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('[data-zoom-img]')) d.close();
    });
    d.addEventListener('close', () => {
      const img = d.querySelector<HTMLImageElement>('[data-zoom-img]');
      if (img) img.removeAttribute('src');
      trigger?.focus();
      trigger = null;
    });
    document.body.append(d);
    dialog = d;
    return d;
  }

  function open(btn: HTMLElement) {
    const d = ensureDialog();
    const inner = btn.querySelector('img');
    const img = d.querySelector<HTMLImageElement>('[data-zoom-img]')!;
    const label = d.querySelector<HTMLElement>('[data-zoom-mockup-label]')!;
    const close = d.querySelector<HTMLButtonElement>('[data-zoom-close-btn]')!;
    img.src = btn.dataset.zoomSrc || inner?.currentSrc || inner?.src || '';
    img.alt = inner?.alt ?? '';
    label.textContent = btn.dataset.zoomMockup ?? '';
    label.hidden = !btn.dataset.zoomMockup;
    close.setAttribute('aria-label', btn.dataset.zoomClose ?? 'Close');
    d.setAttribute('aria-label', btn.dataset.zoomDialog ?? '');
    trigger = btn;
    d.showModal();
    close.focus();
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-zoomable]');
    if (!btn) return;
    e.preventDefault();
    open(btn);
  });
</script>
