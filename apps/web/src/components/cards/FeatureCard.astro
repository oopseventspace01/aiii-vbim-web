---
// 圖文卡：上方插圖（16:10）＋標題＋說明＋連結文字（設計稿：三大能力模組）
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  text: string;
  /** 連結文字照設計稿原文（例如「了解能源管理 →」） */
  linkLabel?: string;
  href: string;
}

const { image, alt, title, text, linkLabel, href } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-[24px] border border-line bg-white text-navy no-underline transition-colors hover:border-blue hover:text-navy"
>
  <Image
    src={image}
    alt={alt}
    widths={[400, 640, 800]}
    sizes="(min-width: 1024px) 400px, 100vw"
    class="block aspect-[16/10] w-full object-cover"
  />
  <div class="flex flex-col gap-2 p-6">
    <span class="text-[21px] font-black">{title}</span>
    <span class="text-[15px] text-muted">{text}</span>
    {linkLabel && <span class="font-bold text-blue group-hover:text-blue-dark">{linkLabel}</span>}
  </div>
</a>
