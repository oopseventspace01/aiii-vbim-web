---
// 頁尾（design/pages/Footer.dc.html；SPEC 3.1 第 13 項：含隱私權政策）
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import { localizePath, type Locale } from '../../lib/i18n';
import { UI } from '../../i18n/ui';
import type { FooterInfo } from '../../data/site-fallback';

interface Props {
  locale: Locale;
  info: FooterInfo;
}

const { locale, info } = Astro.props;
const t = UI[locale];
const lineLabel = locale === 'en' ? 'LINE Official Account' : 'LINE 官方帳號';
// App 下載、LINE 官方帳號、社群連結：後台有填才顯示
const appLinks = [
  { label: 'App Store', href: info.appStoreUrl },
  { label: 'Google Play', href: info.googlePlayUrl },
  { label: lineLabel, href: info.lineOfficialUrl },
  ...(info.socialLinks ?? []).map((s) => ({ label: s.platform, href: s.url })),
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<footer class="bg-navy text-white">
  <div class="container-site flex flex-col gap-9 pt-14 pb-7">
    <div class="flex flex-wrap justify-between gap-10">
      <div class="flex flex-[1_1_300px] flex-col gap-3">
        <div class="self-start rounded-[14px] bg-white px-3.5 py-2.5">
          <Image src={logo} alt="Aiii VBIM" height={38} class="block h-[38px] w-auto" />
        </div>
        <span class="font-display text-[15px] text-[#cfdcf0]">{t.footerSystem}</span>
        <span class="text-sm text-[#aebdd6]">{info.footerTagline}</span>
        <address class="mt-1 flex flex-col gap-0.5 text-sm text-[#cfdcf0] not-italic">
          <span class="font-bold text-white">{info.companyName}</span>
          <span>{info.address}</span>
          <span>
            Tel:{' '}
            <a
              href={`tel:${info.phone.replace(/[^+\d]/g, '')}`}
              class="text-[#cfdcf0] no-underline hover:text-white"
            >
              {info.phone}
            </a>
          </span>
          {info.email && (
            <span>
              Email:{' '}
              <a href={`mailto:${info.email}`} class="text-[#cfdcf0] no-underline hover:text-white">
                {info.email}
              </a>
            </span>
          )}
        </address>
        {appLinks.length > 0 && (
          <div class="mt-1 flex flex-wrap gap-2">
            {appLinks.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center rounded-[10px] border border-white/30 px-3.5 py-2 text-[13px] font-bold text-white no-underline hover:border-white hover:text-white"
              >
                {l.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <nav
        aria-label={locale === 'en' ? 'Footer' : '頁尾選單'}
        class="grid flex-[2_1_560px] grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-6 text-sm"
      >
        {t.footerColumns.map((col) => (
          <div class="flex flex-col gap-2">
            <span class="text-[13px] font-bold text-blue-on-navy">{col.heading}</span>
            {col.links.map((l) => (
              <a
                href={localizePath(l.path, locale)}
                class="text-white no-underline hover:text-blue-on-navy"
              >
                {l.label}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </div>

    <div class="flex flex-wrap justify-between gap-3 border-t border-white/14 pt-5 text-[13px] text-[#aebdd6]">
      <span>{t.footerCopyright}</span>
      <span>{t.footerMotto}</span>
    </div>
  </div>
</footer>
