---
// 回到頂部按鈕（SPEC 3.1）：捲動超過約 300px 才出現；開啟「減少動態效果」時直接跳回頂部
import Icon from '../ui/Icon.astro';
import { UI } from '../../i18n/ui';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const label = UI[Astro.props.locale].backToTop;
---

<button
  type="button"
  aria-label={label}
  title={label}
  data-back-to-top
  data-visible="false"
  class="back-to-top fixed right-4 bottom-[calc(16px+env(safe-area-inset-bottom))] z-50 flex h-[52px] w-[52px] items-center justify-center rounded-pill border-0 bg-blue text-white shadow-[0_8px_24px_rgba(33,96,232,0.35)] hover:bg-blue-dark lg:right-6 lg:bottom-6"
>
  <Icon name="arrow-up" size={24} />
</button>

<style>
  .back-to-top {
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }
  .back-to-top[data-visible='false'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (button) {
    const THRESHOLD = 300;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;

    const update = () => {
      button.dataset.visible = String(window.scrollY > THRESHOLD);
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      // 焦點回到頁首，讓鍵盤使用者從頂端繼續操作
      document.querySelector<HTMLElement>('[data-skip-link]')?.focus({ preventScroll: true });
    });
  }
</script>
