---
// /platform（design/pages/Platform.dc.html）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Pill from '../ui/Pill.astro';
import PageHero from '../blocks/PageHero.astro';
import MediaFigure from '../blocks/MediaFigure.astro';
import CompareTable from '../blocks/CompareTable.astro';
import CtaBand from '../blocks/CtaBand.astro';
import InfoCard from '../cards/InfoCard.astro';
import city from '../../assets/illustrations/city.jpg';
import design from '../../content/design/Platform.json';
import { PLATFORM_COPY } from '../../content/pages/platform';
import { localizePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = PLATFORM_COPY[locale];
const data = design[locale] as {
  caps: { no: string; t: string; d: string }[];
  layers: { no: string; n: string; d: string }[];
  life: { en?: string; zh?: string; t?: string; d: string }[];
  roles: string[];
  pmis: string[];
  four: { t: string; d: string; tags: string }[];
  dims: { k: string; en?: string; d: string }[];
  axes: string[];
  personas: { t: string; d: string }[];
  cmp: { t: string; s: string; l: string; v: string }[];
};
const L = (path: string) => localizePath(path, locale);
---

<BaseLayout title={copy.metaTitle} description={copy.subtitle} locale={locale} active="platform">
  <PageHero eyebrow={copy.eyebrow} title={copy.title} subtitle={copy.subtitle} lead={copy.body}>
    <MediaFigure slot="media" src={city} alt={copy.heroAlt} blend eager />
  </PageHero>

  <!-- 五個核心能力 -->
  <Section labelledby="pf-caps">
    <div class="flex flex-col gap-7">
      <SectionHeader id="pf-caps" title={copy.caps.title} />
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3 p-0">
        {data.caps.map((c) => (
          <li class="flex">
            <InfoCard tone="soft" kicker={c.no} title={c.t} text={c.d} class="w-full" />
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 五層整合架構 -->
  <Section tone="navy" labelledby="pf-layers">
    <div class="flex flex-wrap items-start gap-10">
      <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-4">
        <SectionHeader
          id="pf-layers"
          tone="dark"
          eyebrow={copy.layers.eyebrow}
          title={copy.layers.title}
          lead={copy.layers.lead}
        />
        <p class="m-0 font-display font-semibold text-blue-on-navy">{copy.layers.flow}</p>
      </div>
      <ol class="m-0 flex min-w-0 flex-[1.3_1_480px] list-none flex-col gap-2.5 p-0">
        {data.layers.map((l) => (
          <li class="flex items-center gap-4 rounded-[18px] border border-white/16 bg-white/6 p-4">
            <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-white font-display font-bold text-navy">
              {l.no}
            </span>
            <span class="flex flex-col">
              <span class="text-lg font-black">{l.n}</span>
              <span class="text-sm text-[#cfdcf0]">{l.d}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 全生命週期 -->
  <Section labelledby="pf-life">
    <div class="flex flex-col gap-7">
      <SectionHeader
        id="pf-life"
        eyebrow={copy.life.eyebrow}
        title={copy.life.title}
        lead={copy.life.lead}
      />
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-3 p-0">
        {data.life.map((s) => (
          <li class="flex">
            <InfoCard
              tone="soft"
              kicker={s.en}
              title={s.zh ?? s.t ?? ''}
              text={s.d}
              class="w-full"
            />
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 全週期 PMIS -->
  <Section tone="soft" labelledby="pf-pmis">
    <div class="flex flex-wrap items-start gap-10">
      <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-4">
        <SectionHeader
          id="pf-pmis"
          eyebrow={copy.pmis.eyebrow}
          title={copy.pmis.title}
          lead={copy.pmis.lead}
        />
        <p class="m-0 font-display font-bold text-blue-dark">{copy.pmis.motto}</p>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {data.roles.map((r) => (
            <li>
              <Pill>{r}</Pill>
            </li>
          ))}
        </ul>
      </div>
      <ul class="m-0 grid min-w-0 flex-[1_1_420px] list-none grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-2.5 p-0">
        {data.pmis.map((p) => (
          <li class="flex items-center gap-2.5 rounded-[14px] border border-line bg-white px-4 py-3 font-bold">
            <span aria-hidden="true" class="text-blue">
              ✓
            </span>
            {p}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 四大智慧核心能力 -->
  <Section labelledby="pf-four">
    <div class="flex flex-col gap-7">
      <SectionHeader id="pf-four" title={copy.four.title} lead={copy.four.lead} />
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-3.5 p-0">
        {data.four.map((f) => (
          <li class="flex flex-col gap-2 rounded-md border border-line bg-white p-6">
            <span class="text-[19px] font-black">{f.t}</span>
            <span class="text-[15px] text-text-2">{f.d}</span>
            <span class="mt-auto font-display text-[13px] font-semibold text-blue">{f.tags}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 人、物、天、地、線 -->
  <Section tone="soft" labelledby="pf-dims">
    <div class="flex flex-col gap-7">
      <SectionHeader
        id="pf-dims"
        eyebrow={copy.dims.eyebrow}
        title={copy.dims.title}
        lead={copy.dims.lead}
      />
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3 p-0">
        {data.dims.map((d) => (
          <li class="flex">
            <InfoCard kicker={d.k} kickerLarge title={d.en ?? ''} text={d.d} class="w-full" />
          </li>
        ))}
      </ul>
      <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
        {data.axes.map((a) => (
          <li class="rounded-[10px] bg-navy px-3.5 py-2 text-sm font-bold text-white">{a}</li>
        ))}
        <li class="font-display text-sm font-bold text-blue-dark">{copy.dims.axesEnd}</li>
      </ol>
    </div>
  </Section>

  <!-- 不同角色＋比較表 -->
  <Section labelledby="pf-personas">
    <div class="flex flex-col gap-7">
      <SectionHeader id="pf-personas" title={copy.personas.title} />
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-3.5 p-0">
        {data.personas.map((p) => (
          <li class="flex">
            <InfoCard tone="soft" title={p.t} text={p.d} class="w-full" />
          </li>
        ))}
      </ul>
      <CompareTable
        caption={copy.cmp.caption}
        columns={copy.cmp.columns.map((label, i) => ({ label, highlight: i === 3 }))}
        rows={data.cmp.map((r) => ({ head: r.t, cells: [r.s, r.l, r.v] }))}
      />
    </div>
  </Section>

  <Section spacing="none" class="pb-(--section-y)">
    <CtaBand
      variant="accent"
      title={copy.cta.title}
      text={copy.cta.text}
      primary={{ label: copy.cta.button, href: L('/contact') }}
    />
  </Section>
</BaseLayout>
