---
// /academy（design/pages/Academy.dc.html）：四步取得認證、六大課程模組、誰適合加入、課程梯次（後台）、認證標準、登記（P5）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Pill from '../ui/Pill.astro';
import LeadForm from '../forms/LeadForm.astro';
import InfoCard from '../cards/InfoCard.astro';
import design from '../../content/design/Academy.json';
import { ACADEMY_COPY } from '../../content/pages/academy';
import type { Locale } from '../../lib/i18n';
import { getFooterInfo } from '../../lib/site';
import { getCourses } from '../../lib/cms-pages';
import { isExternalUrl } from '../../lib/rich-text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ACADEMY_COPY[locale];
const data = design[locale] as {
  steps: { no: string; t: string; d: string }[];
  mods: { no: string; en: string; zh?: string; t?: string; d: string }[];
  tracks: { en: string; zh?: string; t?: string; d: string; focus: string }[];
};
const footer = await getFooterInfo(locale);
const courses = await getCourses(locale);
const dateFmt = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'zh-TW', {
  dateStyle: 'medium',
  timeZone: 'Asia/Taipei',
});
const fmt = (d?: string) => (d ? dateFmt.format(new Date(d)) : '');
---

<BaseLayout title={copy.ui.metaTitle} description={copy.lead} locale={locale} active="academy">
  <header class="bg-blue text-white">
    <div class="container-site flex flex-wrap items-end justify-between gap-8 py-14 md:py-[88px]">
      <div class="flex max-w-[820px] flex-col gap-4">
        <p class="m-0 font-display text-sm font-bold tracking-[0.16em] text-[#eef3ff]">
          {copy.eyebrow}
        </p>
        <h1 class="m-0 text-[clamp(2.2rem,4.4vw,3.6rem)] leading-[1.15] font-black">
          {copy.title}
        </h1>
        <p class="m-0 text-xl font-bold">{copy.flow}</p>
        <p class="m-0 text-[1.1rem] text-[#eef3ff]">{copy.lead}</p>
      </div>
      <Button href="#register" variant="white">
        {copy.register}
      </Button>
    </div>
  </header>

  <!-- 四步取得認證 -->
  <Section labelledby="ac-steps">
    <div class="flex flex-col gap-7">
      <SectionHeader id="ac-steps" title={copy.steps.title} />
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3 p-0">
        {data.steps.map((s) => (
          <li class="flex">
            <InfoCard tone="soft" kicker={s.no} title={s.t} text={s.d} class="w-full" />
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 六大課程模組 -->
  <Section tone="soft" labelledby="ac-mods">
    <div class="flex flex-col gap-7">
      <SectionHeader
        id="ac-mods"
        eyebrow={copy.mods.eyebrow}
        title={copy.mods.title}
        lead={copy.mods.lead}
      />
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-3.5 p-0">
        {data.mods.map((m) => (
          <li class="flex flex-col gap-2 rounded-md border border-line bg-white p-6">
            <span class="flex items-baseline gap-2">
              <span class="font-display font-bold text-blue">{m.no}</span>
              <span class="font-display text-lg font-bold text-blue-dark">{m.en}</span>
            </span>
            <span class="font-black">{m.zh ?? m.t}</span>
            <span class="text-[15px] text-text-2">{m.d}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 誰適合加入 -->
  <Section labelledby="ac-tracks">
    <div class="flex flex-col gap-7">
      <SectionHeader id="ac-tracks" title={copy.tracks.title} />
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-3.5 p-0">
        {data.tracks.map((t) => (
          <li class="flex flex-col gap-2 rounded-md bg-navy p-6 text-white">
            <span class="font-display text-sm font-semibold text-blue-on-navy">{t.en}</span>
            <span class="text-xl font-black">{t.zh ?? t.t}</span>
            <span class="text-[15px] text-[#cfdcf0]">{t.d}</span>
            <span class="text-sm font-bold">
              {copy.tracks.focusLabel}
              {t.focus}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 課程與梯次（後台有課程才顯示） -->
  {courses.length > 0 && (
    <Section tone="soft" labelledby="ac-courses">
      <div class="flex flex-col gap-6" data-courses>
        <SectionHeader id="ac-courses" title={copy.ui.coursesTitle} />
        <ul class="m-0 flex list-none flex-col gap-4 p-0">
          {courses.map((c) => (
            <li class="flex flex-col gap-3 rounded-md border border-line bg-white p-6">
              <div class="flex flex-wrap items-center gap-2">
                {c.level && <Pill tone="soft">{copy.ui.levels[c.level] ?? c.level}</Pill>}
                <h3 class="m-0 text-xl font-black">{c.title}</h3>
              </div>
              {c.summary && <p class="m-0 text-text-2">{c.summary}</p>}
              {(c.sessions?.length ?? 0) > 0 && (
                <ul class="m-0 flex list-none flex-col gap-2 p-0">
                  {c.sessions!.map((s) => (
                    <li class="flex flex-wrap items-center gap-x-4 gap-y-1 rounded-[12px] bg-bg-2 px-4 py-3 text-sm">
                      <span class="font-bold">
                        {fmt(s.startDate)}
                        {s.endDate ? ` – ${fmt(s.endDate)}` : ''}
                      </span>
                      {s.location && <span>{s.location}</span>}
                      {typeof s.seats === 'number' && (
                        <span>
                          {copy.ui.seats} {s.seats}
                        </span>
                      )}
                      {s.price && <span>{s.price}</span>}
                      {s.status && (
                        <span class="ml-auto rounded-pill bg-white px-3 py-1 font-bold text-blue-dark">
                          {copy.ui.sessionStatus[s.status] ?? s.status}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
              {c.registerMode === 'external' && c.externalUrl ? (
                <Button
                  href={c.externalUrl}
                  external={isExternalUrl(c.externalUrl)}
                  class="self-start"
                >
                  {copy.ui.registerExternal}
                </Button>
              ) : (
                <Button href="#register" variant="outline" class="self-start">
                  {copy.register}
                </Button>
              )}
            </li>
          ))}
        </ul>
      </div>
    </Section>
  )}

  <!-- 認證標準（SPEC 3.7：內容待業主提供） -->
  <Section labelledby="ac-standards" class="pb-0">
    <div
      class="flex flex-col gap-4 rounded-md border border-line bg-bg-2 p-6 md:p-8"
      data-standards
    >
      <h2 id="ac-standards" class="m-0 text-[1.6rem] font-black">
        {copy.ui.standardsTitle}
      </h2>
      <p class="m-0 text-text-2">{copy.ui.standardsPending}</p>
    </div>
  </Section>

  <!-- 登記首期招生（LeadForm） -->
  <Section id="register" labelledby="ac-register">
    <div class="flex max-w-[820px] flex-col gap-6">
      <SectionHeader id="ac-register" title={copy.form.title} lead={copy.form.lead} />
      <LeadForm variant="academy" locale={locale} fallbackEmail={footer.email} />
    </div>
  </Section>
</BaseLayout>
