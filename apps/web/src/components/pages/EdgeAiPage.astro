---
// /edge-ai（design/pages/EdgeAI.dc.html）：地端 AI 完整解決方案
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Pill from '../ui/Pill.astro';
import PageHero from '../blocks/PageHero.astro';
import MediaFigure from '../blocks/MediaFigure.astro';
import CompareTable from '../blocks/CompareTable.astro';
import CtaBand from '../blocks/CtaBand.astro';
import InfoCard from '../cards/InfoCard.astro';
import edge from '../../assets/illustrations/edge.jpg';
import design from '../../content/design/EdgeAI.json';
import { EDGE_COPY } from '../../content/pages/edge-ai';
import { localizePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = EDGE_COPY[locale];
const data = design[locale] as {
  five: { t: string; d: string }[];
  stack: { l: string; d: string }[];
  design: string[];
  caps: { n: string; u: string; v: string }[];
  forms: { n: string; s: string; d: string }[];
  infra: { t: string; d: string }[];
};
const L = (path: string) => localizePath(path, locale);
---

<BaseLayout title={copy.metaTitle} description={copy.subtitle} locale={locale} active="edge">
  <PageHero eyebrow={copy.eyebrow} title={copy.title} subtitle={copy.subtitle} lead={copy.body}>
    <Button href={L('/contact')} class="self-start">
      {copy.heroCta}
    </Button>
    <MediaFigure slot="media" src={edge} alt={copy.heroAlt} blend eager />
  </PageHero>

  <!-- 五大組成 -->
  <Section label={copy.title}>
    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3 p-0">
      {data.five.map((f) => (
        <li class="flex">
          <InfoCard tone="soft" title={f.t} text={f.d} class="w-full" />
        </li>
      ))}
    </ul>
  </Section>

  <!-- AI-Ready Building Design-In -->
  <Section tone="navy" labelledby="ea-design">
    <div class="flex flex-col gap-8">
      <SectionHeader
        id="ea-design"
        tone="dark"
        eyebrow={copy.design.eyebrow}
        title={copy.design.title}
        lead={copy.design.text}
      />
      <ol class="m-0 flex list-none flex-col gap-2.5 p-0">
        {data.stack.map((s) => (
          <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 rounded-[16px] border border-white/16 bg-white/6 px-5 py-4">
            <span class="min-w-[96px] font-black text-blue-on-navy">{s.l}</span>
            <span class="text-[#cfdcf0]">{s.d}</span>
          </li>
        ))}
      </ol>
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-bold">{copy.design.itemsLabel}</span>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {data.design.map((d) => (
            <li>
              <Pill tone="dark">{d}</Pill>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- 地端 AI 能做什麼 -->
  <Section labelledby="ea-caps">
    <div class="flex flex-col gap-7">
      <SectionHeader id="ea-caps" title={copy.caps.title} />
      <CompareTable
        caption={copy.caps.title}
        columns={copy.caps.columns.map((label) => ({ label }))}
        rows={data.caps.map((c) => ({ head: c.n, cells: [c.u, c.v] }))}
      />
    </div>
  </Section>

  <!-- 四種部署型態＋基礎設施 -->
  <Section tone="soft" labelledby="ea-forms">
    <div class="flex flex-col gap-7">
      <SectionHeader id="ea-forms" title={copy.forms.title} />
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-3.5 p-0">
        {data.forms.map((f) => (
          <li class="flex flex-col gap-1.5 rounded-md border border-line bg-white p-6">
            <span class="font-display text-xl font-bold text-blue-dark">{f.n}</span>
            <span class="font-black">{f.s}</span>
            <span class="text-[15px] text-text-2">{f.d}</span>
          </li>
        ))}
      </ul>
      <h3 class="m-0 text-xl font-black">{copy.forms.infraTitle}</h3>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-3 p-0">
        {data.infra.map((p) => (
          <li class="flex">
            <InfoCard title={p.t} text={p.d} class="w-full" />
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section>
    <CtaBand
      variant="accent"
      title={copy.cta.title}
      text={copy.cta.text}
      primary={{ label: copy.cta.button, href: L('/contact') }}
    />
  </Section>
</BaseLayout>
