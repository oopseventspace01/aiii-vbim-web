# 複製這個檔案為 .env 後填入實際值。.env 已被 .gitignore 排除，絕不 commit。
# 對應 SPEC.md 第 10 節。

# --- Sanity（網站讀取內容）---
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# 讀取草稿預覽用（server only）
SANITY_API_READ_TOKEN=

# --- Sanity Studio（後台；Studio 只讀得到 SANITY_STUDIO_ 開頭的變數）---
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# --- 表單轉送 n8n（server only）---
# 本機開發沒填網址時，表單只會模擬送出成功、不會真的寄出
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_SECRET=

# --- Cloudflare Turnstile 防垃圾 ---
# 本機測試可用 Cloudflare 官方測試金鑰（一定通過）：site 1x00000000000000000000AA／secret 1x0000000000000000000000000000000AA；正式環境務必換成自己申請的
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- 需求表（P5）---
# Google 表單「預填網址」，結尾保留 LEAD_ID，網站會換成預約編號（網址見 docs/需求表/google-forms-urls.md，只在本機）
CHECKLIST_FORM_BUILDING=
CHECKLIST_FORM_MANUFACTURING=
CHECKLIST_FORM_MEDICAL=
CHECKLIST_FORM_RETAIL=
# 需求表 PDF 的 Google 雲端硬碟連結（只附在確認信，不放網站）
CHECKLIST_PDF_BUILDING=
CHECKLIST_PDF_MANUFACTURING=
CHECKLIST_PDF_MEDICAL=
CHECKLIST_PDF_RETAIL=

# --- Google Analytics 4（留空則不載入）---
PUBLIC_GA_ID=

# VERCEL_DEPLOY_HOOK_URL 只設定在 Sanity Webhook 後台，不放在這裡、不進程式碼。
