# 複製這個檔案為 .env 後填入實際值。.env 已被 .gitignore 排除，絕不 commit。
# 對應 SPEC.md 第 10 節。

# --- Sanity（網站讀取內容）---
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# 讀取草稿預覽用（server only）
SANITY_API_READ_TOKEN=

# --- Sanity Studio（後台；Studio 只讀得到 SANITY_STUDIO_ 開頭的變數）---
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# --- 表單轉送 n8n（server only）---
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_SECRET=

# --- Cloudflare Turnstile 防垃圾 ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Analytics 4（留空則不載入）---
PUBLIC_GA_ID=

# VERCEL_DEPLOY_HOOK_URL 只設定在 Sanity Webhook 後台，不放在這裡、不進程式碼。
