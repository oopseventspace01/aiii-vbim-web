{
  "name": "aiii-vbim-web-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/studio"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "studio": "npm run dev -w apps/studio",
    "studio:build": "npm run build -w apps/studio",
    "studio:deploy": "npm run deploy -w apps/studio",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/studio",
    "test": "npm run test -w apps/web && npm run test -w apps/studio",
    "test:e2e": "npm run test:e2e -w apps/web && npm run test:e2e -w apps/studio",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run studio:build",
    "seed": "npm run seed -w apps/studio",
    "seed:force": "npm run seed:force -w apps/studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
